# ============================================================================
# Общие значения для всех сервисов.
# ============================================================================

# --- Образы (версии меняются здесь, а не в docker-compose.yaml) ---
KAFKA_IMAGE=confluentinc/cp-kafka:7.3.0
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.3.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
POSTGRES_IMAGE=postgres:19beta4-alpine3.24

# --- Kafka / Zookeeper: адреса ---
# Внутри сети compose (так видят друг друга контейнеры):
KAFKA_BROKERS=kafka:9092
ZOOKEEPER_CONNECT=zookeeper:2181
# На хосте:
KAFKA_HOST_BROKERS=localhost:9095
KAFKA_HOST_PORT=9095
ZOOKEEPER_HOST_PORT=2181

# --- Порты UI, проброшенные на хост ---
KAFKA_UI_PORT=8080
INTERFACE_PORT=8501

# --- Топики ---
TRANSACTIONS_TOPIC=transactions
SCORING_TOPIC=scoring

# --- Group ID ---
SCORER_GROUP_ID=ml-scorer
WRITER_GROUP_ID=scores-writer

# --- PostgreSQL ---
PG_PORT=5432
PG_USER=app
PG_DB=appdb
POSTGRES_PASSWORD=app
WRITER_BATCH_SIZE=500
WRITER_BATCH_TIMEOUT_S=5
